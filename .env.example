# Скопируйте файл в .env и при необходимости поменяйте значения:
#   cp .env.example .env

# Django
SECRET_KEY=django-insecure-change-me
DEBUG=True
ALLOWED_HOSTS=*

# База данных: по умолчанию sqlite (запуск без установки MySQL).
# Для MySQL поменяйте на mysql и раскомментируйте DB_NAME ниже.
DB_ENGINE=sqlite
# При DB_ENGINE=sqlite имя не указывают — используется db.sqlite3 в корне проекта.
# DB_NAME=mydatabase
DB_USER=myuser
DB_PASSWORD=mypassword
# localhost — при запуске из виртуального окружения,
# db — при запуске через docker compose.
DB_HOST=127.0.0.1
DB_PORT=3306

# Интервал опроса Авито в минутах (по умолчанию 60 = раз в час).
# Поддерживается и короткое имя PERIOD.
PARSE_INTERVAL_MINUTES=60

# --- Прокси и ротация (обход блокировок Авито) -----------------------------
# Файл со списком прокси (один на строку). По умолчанию proxies.txt в корне.
# Пример формата см. в proxies.txt.example.
# PROXY_FILE=proxies.txt

# Прокси через запятую прямо в окружении (объединяется с файлом):
# PROXY_LIST=185.204.0.1:8000,185.204.0.2:8000:user:pass,socks5://10.0.0.5:1080

# Стратегия ротации: round_robin (по кругу) или random.
PROXY_ROTATION=round_robin
# Сколько подряд сбоев терпеть до временного исключения прокси.
PROXY_MAX_FAILURES=3
# На сколько минут исключать сбойный прокси из ротации.
PROXY_COOLDOWN_MINUTES=30
# Сколько разных прокси перебрать на одну задачу при блокировках.
PARSE_PROXY_ATTEMPTS=3
